# ==============================================================================
# Environment Configuration Template — Corporate HR & Payroll Management System
# Copy this file to .env and configure values before starting the application.
# Do NOT commit .env containing real credentials or secrets to version control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Replica Set or Standalone Instance)
MONGO_URI=mongodb://localhost:27017/corporate_hr_db

# JWT Authentication (Never use default or weak secrets in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# API Rate Limiting (express-rate-limit)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
